#: includes/demo-import.php:102
msgid "%d skipped because its SKU already exists."
msgid_plural "%d skipped because their SKU already exists."
msgstr[0] "%d dilewati karena SKU-nya sudah ada."

#: includes/demo-import.php:105
msgid "View store →"
msgstr "Lihat toko →"

#: includes/demo-import.php:111
msgid "%d demo product and its images were deleted."
msgid_plural "%d demo products and their images were deleted."
msgstr[0] "%d produk contoh beserta gambarnya sudah dihapus."

#: includes/demo-import.php:117
msgid "Fill the store with 10 complete demo products (description, attributes, sale prices, stock and images) to see the Verdora theme at its best. Demo data is marked, so the Delete button only removes demo data and never touches your own products."
msgstr "Isi toko dengan 10 produk contoh lengkap (deskripsi, atribut, harga diskon, stok, dan gambar) untuk melihat tampilan tema Verdora secara utuh. Data contoh diberi penanda khusus, sehingga tombol Hapus hanya menghapus data contoh dan tidak menyentuh produk milikmu."

#: includes/demo-import.php:125
msgid "Installed: %d demo product"
msgid_plural "Installed: %d demo products"
msgstr[0] "Terpasang: %d produk contoh"

#: includes/demo-import.php:129
msgid "Not imported yet"
msgstr "Belum diimpor"

#: includes/demo-import.php:136
msgid "Import missing products"
msgstr "Impor yang belum ada"

#: includes/demo-import.php:136
msgid "Import Demo Content"
msgstr "Impor Data Contoh"

#: includes/demo-import.php:141
msgid "Delete all demo products and their images? Your own products will not be deleted."
msgstr "Hapus semua produk contoh beserta gambarnya? Produk milikmu tidak akan terhapus."

#: includes/demo-import.php:144
msgid "Delete Demo Content"
msgstr "Hapus Data Contoh"

#: includes/demo-import.php:149
msgid "What is included"
msgstr "Isi data contoh"

#: includes/demo-import.php:171
msgid "The import uploads about 20 images to the Media Library and may take a few seconds. Missing categories are created and existing ones are reused. Products with the same SKU (VD-DEMO-xxx) are never imported twice."
msgstr "Proses impor mengunggah sekitar 20 gambar ke Media Library dan bisa memakan waktu beberapa detik. Kategori yang belum ada akan dibuat; kategori yang sudah ada dipakai ulang. Produk dengan SKU yang sama (VD-DEMO-xxx) tidak diimpor dua kali."

#: includes/demo-import.php:172
msgid "Image sources and licenses are listed in demo/credits.txt."
msgstr "Sumber dan lisensi gambar ada di demo/credits.txt."

#: includes/demo-import.php:341 includes/demo-import.php:389
msgid "You are not allowed to do this."
msgstr "Kamu tidak punya izin untuk melakukan ini."

#: includes/demo-import.php:481
msgid "Your store is still empty."
msgstr "Toko masih kosong."

#: includes/demo-import.php:482
msgid "Want to see the Verdora theme with products? Import 10 demo products with images. You can delete them again at any time."
msgstr "Ingin melihat tampilan tema Verdora dengan produk? Impor 10 produk contoh lengkap dengan gambar. Bisa dihapus lagi kapan saja."

#: includes/demo-import.php:485
msgid "View Demo Content"
msgstr "Lihat Data Contoh"

#: includes/demo-import.php:486
msgid "Don’t show again"
msgstr "Jangan tampilkan lagi"

#: includes/demo-import.php:67 includes/demo-import.php:68 includes/demo-import.php:93
msgid "Verdora Demo Content"
msgstr "Data Contoh Verdora"

#: includes/demo-import.php:99
msgid "%d demo product imported."
msgid_plural "%d demo products imported."
msgstr[0] "%d produk contoh berhasil diimpor."

